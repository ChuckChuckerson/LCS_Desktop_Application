<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lawyercompany.controller.CaseWindowController">

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="app-header">
        <Label fx:id="caseTitleLabel" styleClass="app-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Статус:"/>
        <Label fx:id="statusLabel" text="" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="statusComboBox" promptText="Статус" visible="false"/>
        <Button fx:id="updateStatusButton" text="Обновить статус" visible="false" onAction="#handleUpdateStatus" styleClass="secondary-button"/>
    </HBox>

    <!-- Блок описания дела -->
    <TitledPane text="Описание дела" expanded="true">
        <TextArea fx:id="descriptionArea" editable="false" wrapText="true" prefHeight="100"
                  style="-fx-background-color: #f5f5f5;"/>
    </TitledPane>

    <TabPane tabClosingPolicy="UNAVAILABLE">
        <Tab text="Сообщения">
            <VBox spacing="10">
                <ListView fx:id="messagesListView" VBox.vgrow="ALWAYS"/>
                <HBox spacing="10">
                    <TextArea fx:id="messageInput" promptText="Введите сообщение..." prefHeight="60" HBox.hgrow="ALWAYS"/>
                    <Button text="Отправить" onAction="#handleSendMessage" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Документы">
            <VBox spacing="10">
                <HBox spacing="10">
                    <Button text="Загрузить документ" onAction="#handleUploadDocument" styleClass="primary-button"/>
                </HBox>
                <TableView fx:id="documentsTable" styleClass="documents-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="docNameColumn" text="Название файла"/>
                        <TableColumn fx:id="docDateColumn" text="Дата загрузки"/>
                        <TableColumn fx:id="docActionColumn" text=""/>
                        <TableColumn fx:id="docDeleteColumn" text=""/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Встречи">
            <VBox spacing="10">
                <HBox spacing="10">
                    <Button fx:id="createMeetingButton" text="Назначить встречу" onAction="#handleCreateMeeting" visible="false" styleClass="primary-button"/>
                </HBox>
                <ListView fx:id="meetingsListView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>