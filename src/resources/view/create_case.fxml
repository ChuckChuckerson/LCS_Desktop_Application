<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" hgap="10" vgap="10" styleClass="form-container"
          xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.lawyercompany.controller.CreateCaseController">

    <Label text="Создание нового дела" styleClass="heading-2"
           GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

    <Label text="Адвокат:" styleClass="label-strong" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="lawyerNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="label-strong"/>

    <Label text="Название дела:" styleClass="label-strong" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <TextField fx:id="titleField" promptText="Например: Иск о возмещении ущерба"
               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Описание:" styleClass="label-strong" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <TextArea fx:id="descriptionArea" promptText="Коротко опишите ситуацию"
              prefRowCount="4"
              GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Button text="Создать" onAction="#handleCreate" styleClass="primary-button"
            GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    <Label fx:id="successLabel" styleClass="success-label" wrapText="true" maxWidth="420"
           GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
</GridPane>